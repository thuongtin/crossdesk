# Cấu hình máy build cho scripts/release/release.sh.
# Chép thành ~/.config/crossdesk/release.env (hoặc trỏ CROSSDESK_RELEASE_CONFIG tới file khác).
# File này chỉ chứa tên host, đường dẫn và tên identity, không bao giờ chứa mật khẩu,
# token hay nội dung khoá.

# Máy Windows x64 (OpenSSH, có git, Visual Studio 2022, xmake, NSIS, LLVM clang-cl).
CROSSDESK_RELEASE_WINDOWS_SSH="user@windows-host"
CROSSDESK_RELEASE_WINDOWS_SSH_PORT=22
CROSSDESK_RELEASE_WINDOWS_DIR='C:\build\crossdesk'

# Máy Linux x86_64 (WSL2 hoặc máy thật) có git, python3, bubblewrap, flock.
CROSSDESK_RELEASE_LINUX_SSH="user@linux-host"
CROSSDESK_RELEASE_LINUX_SSH_PORT=22
CROSSDESK_RELEASE_LINUX_DIR="build/crossdesk"

# macOS: build ngay trên máy Mac Apple Silicon chạy release.sh.
CROSSDESK_RELEASE_MACOS_DIR="$HOME/build/crossdesk"
# Bỏ trống ba biến dưới để dry-run không ký. --publish bắt buộc cả ba.
CROSSDESK_MACOS_SIGN_IDENTITY="Developer ID Application: Example Name (TEAMID)"
CROSSDESK_MACOS_INSTALLER_IDENTITY="Developer ID Installer: Example Name (TEAMID)"
CROSSDESK_MACOS_NOTARY_PROFILE="crossdesk-notary"
# Tuỳ chọn: keychain riêng chứa hai identity trên.
# CROSSDESK_MACOS_KEYCHAIN="$HOME/Library/Keychains/crossdesk-release.keychain-db"

# Khoá bí mật Ed25519 (PEM) ký feed cập nhật, chmod 600, nằm ngoài repo. Chỉ cần cho --publish.
CROSSDESK_UPDATE_PRIVATE_KEY_FILE="$HOME/.config/crossdesk/update-signing-key.pem"
