# Cấu hình máy build cho scripts/release/release.sh.
# Chép thành ~/.config/crossdesk/release.env (hoặc trỏ CROSSDESK_RELEASE_CONFIG tới file khác).
# File này chỉ chứa tên host, đường dẫn và mã định danh, không bao giờ chứa mật khẩu,
# token hay nội dung khoá.

# Máy Windows x64 (OpenSSH, có git, Visual Studio 2022, xmake, NSIS, LLVM clang-cl).
CROSSDESK_RELEASE_WINDOWS_SSH="user@windows-host"
CROSSDESK_RELEASE_WINDOWS_SSH_PORT=22
CROSSDESK_RELEASE_WINDOWS_DIR='C:\build\crossdesk'

# Máy Linux x86_64 (WSL2 hoặc máy thật) có git, python3, bubblewrap, flock.
CROSSDESK_RELEASE_LINUX_SSH="user@linux-host"
CROSSDESK_RELEASE_LINUX_SSH_PORT=22
CROSSDESK_RELEASE_LINUX_DIR="build/crossdesk"

# macOS: build ngay trên máy Mac Apple Silicon chạy release.sh.
CROSSDESK_RELEASE_MACOS_DIR="$HOME/build/crossdesk"
# "auto": build_macos.sh tự lấy identity Developer ID lúc chạy, nên họ tên và Team ID không nằm
# trong file nào. Chỉ khi keychain có nhiều identity cùng loại mới ghi tên đầy đủ ở đây.
# Bỏ trống để dry-run không ký. --publish bắt buộc cả hai identity và thông tin notarize.
CROSSDESK_MACOS_SIGN_IDENTITY="auto"
CROSSDESK_MACOS_INSTALLER_IDENTITY="auto"
# Notarize bằng khoá API App Store Connect: đường dẫn file .p8 (ngoài repo), Key ID, Issuer ID.
# Có thể nạp từ file env riêng rồi gán lại, ví dụ:
#   source "$HOME/.private_keys/notary.env"
#   CROSSDESK_MACOS_NOTARY_KEY="$<BIẾN_ĐƯỜNG_DẪN_P8>"
CROSSDESK_MACOS_NOTARY_KEY="$HOME/.private_keys/AuthKey_<KEYID>.p8"
CROSSDESK_MACOS_NOTARY_KEY_ID="<KEYID>"
CROSSDESK_MACOS_NOTARY_ISSUER="<ISSUER_ID>"
# Dự phòng khi không đặt khoá API: profile notarytool trong keychain.
# CROSSDESK_MACOS_NOTARY_PROFILE="crossdesk-notary"
# Tuỳ chọn: chỉ tìm identity trong một keychain riêng.
# CROSSDESK_MACOS_KEYCHAIN="$HOME/Library/Keychains/crossdesk-release.keychain-db"

# Khoá bí mật Ed25519 (PEM) ký feed cập nhật, chmod 600, nằm ngoài repo. Chỉ cần cho --publish.
# Phải khớp FORK_UPDATE_PUBLIC_KEY trong scripts/release/lib.sh (xem docs/RELEASE.md, mục 2.5).
CROSSDESK_UPDATE_PRIVATE_KEY_FILE="$HOME/.private_keys/crossdesk-update-ed25519.pem"
